@page
@model LojaDeFunkos.Pages.Universos.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Deletar</h1>

<h3>tem certeza que quer deletar?</h3>
<div>
    <h4>Universo</h4>
    <hr />
    <dl class="row bg-dark text-white">
        <dt class="col-sm-2">
            Nome
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Universo.Nome)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Universo.UniversoId" />
        <input type="submit" value="Deletar" class="btn btn-danger" /> |
        <a asp-page="./Index">Voltar a lista</a>
    </form>
</div>
