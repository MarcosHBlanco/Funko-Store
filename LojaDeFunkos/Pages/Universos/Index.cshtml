@page
@model LojaDeFunkos.Pages.Universos.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Seus Universos</h1>

<p>
    <a asp-page="Create">Criar novo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Universo[0].Nome)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Universo) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.UniversoId">Editar</a> |
                <a asp-page="./Details" asp-route-id="@item.UniversoId">Detalhes</a> |
                <a asp-page="./Delete" asp-route-id="@item.UniversoId">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
