@page "/funko/{slug}/{id}"
@model LojaDeFunkos.DetalhesModel

<h2 class="my-3">@Model.Funko.Nome</h2>
<div class="row">
    <div class="col-5">
        <img class="img-fluid rounded" src="@Model.Funko.ImagemUri">
    </div>
    <div class="col-5 bg-primary text-white">
        <h4 class="my-3">Sobre:</h4>
        <p>@Model.Funko.Descricao</p>
        <h4 class="my-3">Mais Info:</h4>
        <ul>
            <li>
                <label asp-for="Funko.Preco"></label>:
                @Html.DisplayFor(model => model.Funko.Preco)
            </li>
            <li>
                <label asp-for="Funko.Status"></label>:
                @Model.Funko.EntregaExpressaFormatada
            </li>
            <li>
                <label asp-for="Funko.DataCadastro"></label>:
                @Html.DisplayFor(model => model.Funko.DataCadastro)
            </li>
            @if (Model.DescricaoMarca is not null)
            {
                <li>
                    <label asp-for="Funko.MarcaId"></label>:
                    @Html.DisplayFor(model => model.DescricaoMarca)
                </li>
            }
            @if (Model.Funko.Universos.Count > 0)
            {
                <li>
                    <label asp-for="Funko.Universos"></label>(s):
                    @string.Join(", ", Model.Funko.Universos.Select(item => item.Nome))
                </li>
            }
        </ul>
        @if (User.Identity.IsAuthenticated)
         {
            <a class="btn my-3 btn-secondary"
               asp-page="/Editar" asp-route-id="@Model.Funko.FunkoId">Editar</a>
         }  
        </div>
</div>

